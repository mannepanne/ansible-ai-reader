# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-secret-key-here

# Readwise Reader API (Phase 3)
READER_API_TOKEN=your-reader-api-token-here

# Perplexity API (Phase 4)
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# Resend Email (Phase 2)
RESEND_API_KEY=your-resend-api-key-here

# Contact Form (Cloudflare Turnstile CAPTCHA)
# Create a Turnstile site at: https://dash.cloudflare.com/?to=/:account/turnstile
# For local testing, use Cloudflare's always-pass test keys:
#   Site key:   1x00000000000000000000AA
#   Secret key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your-turnstile-site-key-here
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here

# Contact form — never exposed to the client
# RESEND_FROM_EMAIL must be a verified sender in your Resend account
RESEND_FROM_EMAIL=your-verified-sender@example.com
CONTACT_EMAIL=your-recipient-email@example.com

# Cloudflare Web Analytics (public site token, cookieless pageview + CWV beacon)
# Get one at: https://dash.cloudflare.com → Analytics & Logs → Web Analytics → Add a site
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=your-cloudflare-web-analytics-token-here

# Relay Stage 2.3b — the single-owner user id the engagement-gated archive-hook is scoped to.
# Unset ⟹ the auto-trigger never fires and the admin toggle renders disabled. See the 2026-07-10 ADR.
RELAY_OWNER_USER_ID=your-relay-owner-user-uuid-here

# Fika (spec 13) — signs the action links in the daily email. Any long random string; rotating it
# invalidates links in emails already sent (they show "this link has expired").
# Generate one with: openssl rand -base64 32
FIKA_ACTION_SECRET=replace-with-a-long-random-string
# Site URL used for links in the Fika email (server-side only; defaults to https://ansible.hultberg.org when unset)
SITE_URL=http://localhost:3000
